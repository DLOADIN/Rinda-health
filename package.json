{
  "name": "rinda-health",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/rules",
    "packages/schemas",
    "packages/content",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"npm run dev -w @rinda/backend\" \"npm run dev -w @rinda/frontend\"",
    "build": "npm run build -w @rinda/frontend",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "vitest run",
    "test:golden": "vitest run --project rules packages/rules/test/golden.test.ts",
    "test:coverage": "vitest run --project rules --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:logs": "node scripts/check-logs.mjs",
    "content:validate": "tsx packages/content/scripts/validate.ts",
    "db:migrate": "npm run db:migrate -w @rinda/backend",
    "db:seed": "npm run db:seed -w @rinda/backend",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && vitest run && npm run content:validate && npm run build && npm run check:size && npm run check:contrast",
    "db:check": "npm run db:check -w @rinda/backend",
    "models:check": "npm run models:check -w @rinda/backend"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
