# Copy this file to .env at the repository root (never commit .env).
# The backend (backend/server.ts) checks every variable at start-up and stops with a clear message if one is wrong.

# development | staging | pilot | test   (pilot only after ethics approval)
APP_ENV=development

# ── Database: PostgreSQL on Neon ────────────────────────────────────────────────────────────────────────────────
# Neon console > your project > Connect, with "Connection pooling" ON: the host contains "-pooler".
# Keep "?sslmode=require" at the end. DIRECT_URL is optional: the backend removes "-pooler" itself.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DIRECT_URL=

# ── Sessions ────────────────────────────────────────────────────────────────────────────────────────────────────
# A long random string (at least 32 characters). Make one with
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=8

# Where people open the app. Google sends people back to PUBLIC_URL/api/v1/auth/google/callback.
PUBLIC_URL=http://localhost:5173
PORT=3000

# ── Google sign-in (optional) ───────────────────────────────────────────────────────────────────────────────────
# Google Cloud console > APIs & Services > Credentials > OAuth client ID > Web application.
# Authorised JavaScript origin: http://localhost:5173
# Authorised redirect URI:      http://localhost:5173/api/v1/auth/google/callback
# After deployment add the same two entries with your live address and set PUBLIC_URL to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Rinda Guide AI (FR-36, ADR-019) ─────────────────────────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey  (free-tier prompts may be used by Google to improve its products).
# The AI stays OFF unless ETHICS_AMENDMENT_REF is also set, the admin switches on the guide flag, and each
# participant opts in from Profile. For synthetic development data you may set ETHICS_AMENDMENT_REF=SYNTHETIC-DEV-ONLY;
# the backend refuses any SYNTHETIC value when APP_ENV=pilot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ETHICS_AMENDMENT_REF=
# The pilot also needs true here: a paid Gemini tier whose terms say prompts are not used for training.
GEMINI_PAID_TIER=false

# ── WhatsApp notices (ADR-020): "your summary is ready", never any results ─────────────────────────────────────
# Meta for Developers > your app > WhatsApp > API Setup: a permanent access token and the Phone number ID.
# Create and get approved a message template (default name below) in WhatsApp Manager > Message templates.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=rinda_summary_ready
WHATSAPP_TEMPLATE_LANGUAGE_EN=en
WHATSAPP_TEMPLATE_LANGUAGE_RW=en
WHATSAPP_API_VERSION=v21.0
# The pilot refuses to switch on the "messaging" flag until this holds the ethics approval reference for notices.
MESSAGING_APPROVAL_REF=

# ── Demo data ───────────────────────────────────────────────────────────────────────────────────────────────────
# Password for the synthetic demo accounts created by `npm run db:seed`. Empty: a random one is printed once.
SEED_PASSWORD=

# pino level: fatal | error | warn | info | debug (bodies and personal values are never logged)
LOG_LEVEL=info
